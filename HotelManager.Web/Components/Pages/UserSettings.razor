@page "/settings/users"
@attribute [Authorize(Policy = HotelPolicies.ManageUsers)]
@rendermode InteractiveServer
@inject IUserAdministrationService UserAdministration
@inject IJSRuntime JS
@inject IStringLocalizer<UserSettings> L

<PageTitle>@L["Users & roles"]</PageTitle>

<div class="settings-page">
    <header class="settings-header">
        <div>
            <h1>@L["Users & roles"]</h1>
            <p class="settings-subtitle">@L["Invite your team and control what each role can see and change."]</p>
        </div>
        <div class="settings-actions">
            <button type="button" class="btn btn-primary" @onclick="OpenNewUser">@L["+ New user"]</button>
        </div>
    </header>

    @if (pageError is not null)
    {
        <div class="alert alert-danger" role="alert">@pageError</div>
    }

    @if (pageNotice is not null)
    {
        <div class="alert alert-success alert-dismissible" role="status">
            @pageNotice
            <button type="button" class="btn-close" aria-label="@L["Close"]" @onclick="() => pageNotice = null"></button>
        </div>
    }

    @if (issuedPassword?.Password is not null)
    {
        <div class="password-reveal" role="status">
            <div>
                <strong>@L["One-time password for {0}", issuedPassword.User.Email]</strong>
                <p>@L["Hand it over securely. The user should change it after the first sign-in. It will not be shown again."]</p>
            </div>
            <code class="password-value">@issuedPassword.Password</code>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CopyPasswordAsync">@(passwordCopied ? L["Copied"] : L["Copy"])</button>
            <button type="button" class="btn-close" aria-label="@L["Close"]" @onclick="() => issuedPassword = null"></button>
        </div>
    }

    <section class="inventory-card">
        @if (users is null)
        {
            <p><em>@L["Loading..."]</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover inventory-table">
                    <thead>
                        <tr>
                            <th>@L["Name"]</th>
                            <th>@L["Email"]</th>
                            <th>@L["Role"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Created"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr class="inventory-row @(user.IsLocked ? "archived" : null) @(selected?.Id == user.Id ? "selected" : null)" @onclick="() => OpenUser(user)">
                                <td>
                                    <strong>@user.DisplayName</strong>
                                    @if (user.IsCurrentUser)
                                    {
                                        <span class="you-badge">@L["You"]</span>
                                    }
                                </td>
                                <td>
                                    @user.Email
                                    @if (user.OtherHotelCount > 0)
                                    {
                                        <span class="you-badge" title="@L["This account also has access to other hotels."]">@L["+{0} hotels", user.OtherHotelCount]</span>
                                    }
                                </td>
                                <td><span class="role-badge role-@user.Role.ToLowerInvariant()">@RoleLabel(user.Role)</span></td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="status-badge archived">@L["Deactivated"]</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge active">@L["Active"]</span>
                                    }
                                </td>
                                <td>@user.CreatedAtUtc.ToLocalTime().ToString("d")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="role-matrix">
        <h2>@L["What can each role do?"]</h2>
        <div class="role-matrix-grid">
            @foreach (var role in HotelRoles.All)
            {
                <div class="role-card">
                    <span class="role-badge role-@role.ToLowerInvariant()">@RoleLabel(role)</span>
                    <p>@RoleDescription(role)</p>
                </div>
            }
        </div>
    </section>
</div>

@if (drawerOpen)
{
    <div class="drawer-backdrop" @onclick="CloseDrawer"></div>
    <aside class="inventory-drawer" role="dialog" aria-modal="true" aria-labelledby="user-drawer-title" tabindex="-1" @ref="drawerElement" @onkeydown="OnDrawerKeyDown">
        <header class="inventory-drawer-header">
            <h2 id="user-drawer-title">@(selected is null ? L["New user"] : selected.DisplayName)</h2>
            <button type="button" class="btn-close" aria-label="@L["Close"]" @onclick="CloseDrawer"></button>
        </header>

        <div class="inventory-drawer-body">
            @if (drawerError is not null)
            {
                <div class="alert alert-danger mb-0" role="alert">@drawerError</div>
            }

            <div class="form-grid">
                <label class="span-2">
                    <span>@L["Name"]</span>
                    <input class="form-control" @bind="formDisplayName" @bind:event="oninput" maxlength="120" disabled="@(selected is { CanManageAccount: false })" />
                </label>
                <label class="span-2">
                    <span>@L["Email"]</span>
                    <input class="form-control" type="email" @bind="formEmail" @bind:event="oninput" disabled="@(selected is not null)" maxlength="256" />
                </label>
                <label class="span-2">
                    <span>@L["Role"]</span>
                    <select class="form-select" @bind="formRole">
                        @foreach (var role in HotelRoles.All)
                        {
                            <option value="@role">@RoleLabel(role)</option>
                        }
                    </select>
                </label>
            </div>
            <p class="drawer-hint">@RoleDescription(formRole)</p>

            @if (hotelAccess is { Count: > 0 })
            {
                <div class="hotel-access">
                    <h3>@L["Access to other hotels"]</h3>
                    <p>@L["Choose the other hotels this user may work in and the role there. The user switches between hotels in the header."]</p>
                    @foreach (var hotel in hotelAccess)
                    {
                        <div class="hotel-access-row @(hotel.HasAccess ? "granted" : null)">
                            <label class="hotel-access-name" title="@(hotel.CanEdit ? null : L["You do not administer this hotel."].Value)">
                                <input type="checkbox" class="form-check-input" @bind="hotel.HasAccess" disabled="@(!hotel.CanEdit || busy)" />
                                <span>
                                    @hotel.Name
                                    @if (!string.IsNullOrWhiteSpace(hotel.City))
                                    {
                                        <small>@hotel.City</small>
                                    }
                                </span>
                            </label>
                            <select class="form-select form-select-sm" @bind="hotel.Role" disabled="@(!hotel.CanEdit || !hotel.HasAccess || busy)" aria-label="@L["Role in {0}", hotel.Name]">
                                @foreach (var role in HotelRoles.All)
                                {
                                    <option value="@role">@RoleLabel(role)</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            }

            @if (selected is null)
            {
                <p class="drawer-hint">@L["A secure one-time password is generated when the user is created. If the email already has an account (e.g. in another hotel), that account is added to this hotel and keeps its password."]</p>
            }
            else if (!selected.IsCurrentUser)
            {
                @if (!selected.CanManageAccount)
                {
                    <p class="drawer-hint">@L["This account also belongs to hotels you do not administer. Name and password can only be changed by an administrator of all its hotels."]</p>
                }
                <div class="danger-zone">
                    <h3>@L["Access"]</h3>
                    <p>@L["Resetting the password or deactivating access to this hotel signs the user out of all sessions."]</p>
                    <div class="danger-actions">
                        @if (selected.CanManageAccount)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetPasswordAsync" disabled="@busy">@L["Reset password"]</button>
                        }
                        @if (selected.IsLocked)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => SetLockedAsync(false)" disabled="@busy">@L["Reactivate access"]</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => SetLockedAsync(true)" disabled="@busy">@L["Deactivate access"]</button>
                        }
                    </div>
                </div>
            }
        </div>

        <footer class="inventory-drawer-footer">
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDrawer">@L["Cancel"]</button>
            <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(busy || !CanSave)">
                @(selected is null ? L["Create user"] : L["Save"])
            </button>
        </footer>
    </aside>
}

@code {
    private IReadOnlyList<UserSummary>? users;
    private UserSummary? selected;
    private UserPasswordResult? issuedPassword;
    private ElementReference drawerElement;
    private bool drawerOpen;
    private bool focusDrawer;
    private bool busy;
    private bool passwordCopied;
    private string? pageError;
    private string? pageNotice;
    private string? drawerError;
    private string formDisplayName = string.Empty;
    private string formEmail = string.Empty;
    private string formRole = HotelRoles.FrontDesk;
    private List<HotelAccessRow>? hotelAccess;

    private sealed class HotelAccessRow(UserHotelAccess access)
    {
        public Guid HotelId { get; } = access.HotelId;
        public string Name { get; } = access.HotelName;
        public string? City { get; } = access.City;
        public bool CanEdit { get; } = access.CanEdit;
        public bool HasAccess { get; set; } = access.HasAccess;
        public string Role { get; set; } = access.Role ?? HotelRoles.FrontDesk;

        public bool IsChanged => HasAccess != access.HasAccess || (HasAccess && Role != access.Role);

        public UserHotelAssignment ToAssignment() => new(HotelId, HasAccess ? Role : null);
    }

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(formDisplayName) &&
        (selected is not null || !string.IsNullOrWhiteSpace(formEmail));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDrawer && drawerOpen)
        {
            focusDrawer = false;
            await drawerElement.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            users = await UserAdministration.GetUsersAsync();
            pageError = null;
        }
        catch (UserAdministrationException exception)
        {
            pageError = exception.Message;
            users = [];
        }
    }

    private async Task OpenNewUser()
    {
        selected = null;
        formDisplayName = string.Empty;
        formEmail = string.Empty;
        formRole = HotelRoles.FrontDesk;
        await OpenDrawerAsync(null);
    }

    private async Task OpenUser(UserSummary user)
    {
        selected = user;
        formDisplayName = user.DisplayName;
        formEmail = user.Email;
        formRole = string.IsNullOrEmpty(user.Role) ? HotelRoles.FrontDesk : user.Role;
        await OpenDrawerAsync(user.Id);
    }

    private async Task OpenDrawerAsync(string? userId)
    {
        drawerError = null;
        hotelAccess = null;
        drawerOpen = true;
        focusDrawer = true;
        try
        {
            hotelAccess = (await UserAdministration.GetOtherHotelsAsync(userId)).Select(access => new HotelAccessRow(access)).ToList();
        }
        catch (UserAdministrationException exception)
        {
            drawerError = exception.Message;
        }
    }

    private void CloseDrawer()
    {
        drawerOpen = false;
        selected = null;
        drawerError = null;
        hotelAccess = null;
    }

    private void OnDrawerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDrawer();
        }
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            if (selected is null)
            {
                var created = await UserAdministration.CreateAsync(new UserCreateRequest(formEmail, formDisplayName, formRole));
                await SaveHotelAccessAsync(created.User.Id);
                issuedPassword = created.Password is null ? null : created;
                pageNotice = created.Password is null
                    ? L["{0} already had an account and now has access to this hotel. The existing password stays valid.", created.User.Email].Value
                    : null;
                passwordCopied = false;
            }
            else
            {
                await UserAdministration.UpdateAsync(selected.Id, new UserUpdateRequest(formDisplayName, formRole));
                await SaveHotelAccessAsync(selected.Id);
            }

            CloseDrawer();
        });
    }

    private async Task SaveHotelAccessAsync(string userId)
    {
        var changes = hotelAccess?.Where(row => row.CanEdit && row.IsChanged).Select(row => row.ToAssignment()).ToList();
        if (changes is { Count: > 0 })
        {
            await UserAdministration.SetOtherHotelsAsync(userId, changes);
        }
    }

    private async Task SetLockedAsync(bool locked)
    {
        if (selected is null)
        {
            return;
        }

        await RunAsync(async () =>
        {
            selected = await UserAdministration.SetLockedAsync(selected.Id, locked);
        });
    }

    private async Task ResetPasswordAsync()
    {
        if (selected is null)
        {
            return;
        }

        await RunAsync(async () =>
        {
            issuedPassword = await UserAdministration.ResetPasswordAsync(selected.Id);
            passwordCopied = false;
            CloseDrawer();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        drawerError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (UserAdministrationException exception)
        {
            drawerError = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CopyPasswordAsync()
    {
        if (issuedPassword is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", issuedPassword.Password);
            passwordCopied = true;
        }
        catch (JSException)
        {
            passwordCopied = false;
        }
    }

    private string RoleLabel(string role) => role switch
    {
        HotelRoles.Admin => L["Administrator"],
        HotelRoles.Manager => L["Manager"],
        HotelRoles.FrontDesk => L["Front desk"],
        HotelRoles.Housekeeping => L["Housekeeping"],
        _ => role
    };

    private string RoleDescription(string role) => role switch
    {
        HotelRoles.Admin => L["Full access including users, rooms, rates and billing."],
        HotelRoles.Manager => L["Room planner, billing, rooms, categories, rates and availability."],
        HotelRoles.FrontDesk => L["Room planner, reservations, check-in/out and billing."],
        HotelRoles.Housekeeping => L["Sign-in only for now; the housekeeping app follows."],
        _ => string.Empty
    };
}
