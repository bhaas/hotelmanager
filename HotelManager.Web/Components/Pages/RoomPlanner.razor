    private string GetRoomLabel(Guid roomId)
    {
        var room = snapshot?.Rooms.FirstOrDefault(item => item.RoomId == roomId);
        return room?.RoomNumber ?? roomId.ToString();
    }

    private bool RoomMatchesFilters(RoomPlannerRoom room)
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();
            var roomMatches = room.RoomNumber.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                              room.RoomType.Contains(search, StringComparison.OrdinalIgnoreCase);
            var guestMatches = room.Reservations.Any(reservation =>
                reservation.GuestName.Contains(search, StringComparison.OrdinalIgnoreCase));

            if (!roomMatches && !guestMatches)
            {
                return false;
            }
        }

        return statusFilter switch
        {
            "checkedin" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.CheckedIn),
            "confirmed" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.Confirmed),
            "maintenance" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.Maintenance),
            "blocked" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.Blocked),
            "dirty" => room.HousekeepingStatus == HousekeepingStatus.Dirty,
            _ => true
        };
    }

    private int GetInHouseCount()
    {
        if (snapshot is null)
        {
            return 0;
        }

        return snapshot.Rooms.Count(room => room.Reservations.Any(reservation =>
            reservation.Status == ReservationStatus.CheckedIn &&
            reservation.CheckIn <= viewStartDate &&
            reservation.CheckOut > viewStartDate));
    }

    private int GetArrivalsCount()
    {
        if (snapshot is null)
        {
            return 0;
        }

        return snapshot.Rooms.Sum(room => room.Reservations.Count(reservation => reservation.CheckIn == viewStartDate));
    }

    private int GetDeparturesCount()
    {
        if (snapshot is null)
        {
            return 0;
        }

        return snapshot.Rooms.Sum(room => room.Reservations.Count(reservation => reservation.CheckOut == viewStartDate));
    }

