    private async Task SaveReservationAsync()
    {
        if (editor is null)
        {
            return;
        }

        if (editor.CheckOut <= editor.CheckIn)
        {
            operationError = L["Check-out must be after check-in."];
            operationMessage = null;
            return;
        }

        if (editor.Occupancy <= 0)
        {
            operationError = L["Occupancy must be greater than 0."];
            operationMessage = null;
            return;
        }

        var request = new RoomPlannerReservationUpsertRequest(
            editor.RoomId,
            editor.GuestName,
            editor.CheckIn,
            editor.CheckOut,
            editor.Occupancy,
            editor.Status,
            editor.Notes);

        if (editor.ReservationId is null)
        {
            await ExecuteReservationActionAsync(
                () => RoomPlannerCommandService.CreateReservationAsync(request, CancellationToken.None),
                L["Reservation created."]);
            return;
        }

        var reservationId = editor.ReservationId.Value;
        await ExecuteReservationActionAsync(
            () => RoomPlannerCommandService.UpdateReservationAsync(reservationId, request, CancellationToken.None),
            L["Reservation updated."]);
