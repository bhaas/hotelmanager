@page "/room-planner"
@using System.Globalization
@rendermode InteractiveServer
@inject IRoomPlannerQueryService RoomPlannerQueryService
@inject IRoomPlannerCommandService RoomPlannerCommandService
@inject IRateAvailabilityService RateAvailabilityService
@inject IBillingService BillingService
@inject IStringLocalizer<RoomPlanner> L
@inject IJSRuntime JS

<PageTitle>@L["Room Planner"]</PageTitle>

<div class="planner-page">
    <header class="planner-header">
        <div>
            <h1>@L["Room Planner"]</h1>
            <p class="planner-subtitle">@L["High-density planning board inspired by modern hotel operations dashboards."]</p>
        </div>
        <div class="planner-controls">
            <button class="btn btn-outline-secondary" @onclick='() => ShiftWindowAsync(-1)' disabled="@isLoading">← @L["Previous"]</button>
            <button class="btn btn-outline-secondary" @onclick="JumpToTodayAsync" disabled="@isLoading">@L["Today"]</button>
            <button class="btn btn-outline-secondary" @onclick='() => ShiftWindowAsync(1)' disabled="@isLoading">@L["Next"] →</button>
            <button class="btn btn-primary"
                    @onclick="StartCreateReservation"
                    disabled="@(isLoading || snapshot is null || snapshot.Rooms.Count == 0)">
                + @L["New reservation"]
            </button>
            <label class="days-label" for="days-window">@L["Window"]</label>
            <select id="days-window" class="form-select days-select" @bind="daysToShow" @bind:after="ReloadAsync" disabled="@isLoading">
                <option value="7">@L["{0} days", 7]</option>
                <option value="14">@L["{0} days", 14]</option>
                <option value="21">@L["{0} days", 21]</option>
                <option value="31">@L["{0} days", 31]</option>
            </select>
            <input class="form-control room-search"
                   type="search"
                   placeholder="@L["Search room, type, or guest"]"
                   @bind="searchText" />
            <select class="form-select status-filter" @bind="statusFilter">
                <option value="all">@L["All statuses"]</option>
                <option value="checkedin">@GetStatusLabel(ReservationStatus.CheckedIn)</option>
                <option value="confirmed">@GetStatusLabel(ReservationStatus.Confirmed)</option>
                <option value="maintenance">@GetStatusLabel(ReservationStatus.Maintenance)</option>
                <option value="blocked">@GetStatusLabel(ReservationStatus.Blocked)</option>
            </select>
        </div>
    </header>

    @if (operationError is not null)
    {
        <div class="alert alert-danger" role="alert">
            @operationError
        </div>
    }
    else if (operationMessage is not null)
    {
        <div class="alert alert-success" role="alert">
            @operationMessage
        </div>
    }

    @if (snapshot is not null)
    {
        <div class="planner-kpis">
            <div class="kpi-card">
                <div class="kpi-value">@snapshot.Rooms.Count</div>
                <div class="kpi-label">@L["Rooms in planner"]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-value">@GetInHouseCount()</div>
                <div class="kpi-label">@L["In house ({0})", viewStartDate.ToString("dd MMM")]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-value">@GetArrivalsCount()</div>
                <div class="kpi-label">@L["Arrivals ({0})", viewStartDate.ToString("dd MMM")]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-value">@GetDeparturesCount()</div>
                <div class="kpi-label">@L["Departures ({0})", viewStartDate.ToString("dd MMM")]</div>
            </div>
        </div>

        <section class="rate-engine-section">
            <div class="rate-engine-header">
                <h2>@L["Rate & availability engine"]</h2>
                <p>@L["Configure room rates and sell restrictions for cloud-ready pricing control."]</p>
            </div>

            @if (rateEngineError is not null)
            {
                <div class="alert alert-danger" role="alert">@rateEngineError</div>
            }
            else if (rateEngineMessage is not null)
            {
                <div class="alert alert-success" role="alert">@rateEngineMessage</div>
            }

            <div class="rate-engine-grid">
                <div class="rate-engine-card">
                    <h3>@L["Add room rate rule"]</h3>
                    <div class="rate-engine-form-grid">
                        <select class="form-select" @bind="rateRule.RoomType">
                            @foreach (var roomType in RoomTypeOptions)
                            {
                                <option value="@roomType">@roomType</option>
                            }
                        </select>
                        <InputDate class="form-control" @bind-Value="rateRule.StartDate" />
                        <InputDate class="form-control" @bind-Value="rateRule.EndDate" />
                        <InputNumber class="form-control" @bind-Value="rateRule.OccupancyFrom" />
                        <InputNumber class="form-control" @bind-Value="rateRule.OccupancyTo" />
                        <InputNumber class="form-control" @bind-Value="rateRule.NightlyNetAmount" />
                        <InputSelect class="form-select" @bind-Value="rateRule.VatRatePercent">
                            <option value="20">20%</option>
                            <option value="13">13%</option>
                            <option value="10">10%</option>
                            <option value="0">0%</option>
                        </InputSelect>
                        <InputNumber class="form-control" @bind-Value="rateRule.Priority" />
                    </div>
                    <button type="button" class="btn btn-outline-primary" @onclick="AddRateRuleAsync" disabled="@isExecutingRateEngine">
                        @L["Save rate rule"]
                    </button>
                </div>

                <div class="rate-engine-card">
                    <h3>@L["Add availability rule"]</h3>
                    <div class="rate-engine-form-grid">
                        <InputSelect class="form-select" @bind-Value="availabilityRule.Scope">
                            <option value="type">@L["By room type"]</option>
                            <option value="room">@L["By specific room"]</option>
                        </InputSelect>

                        @if (availabilityRule.Scope == "room")
                        {
                            <InputSelect class="form-select" @bind-Value="availabilityRule.RoomId">
                                @foreach (var room in snapshot.Rooms.OrderBy(item => item.RoomNumber))
                                {
                                    <option value="@room.RoomId">@room.RoomNumber · @room.RoomType</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <select class="form-select" @bind="availabilityRule.RoomType">
                                @foreach (var roomType in RoomTypeOptions)
                                {
                                    <option value="@roomType">@roomType</option>
                                }
                            </select>
                        }

                        <InputDate class="form-control" @bind-Value="availabilityRule.StartDate" />
                        <InputDate class="form-control" @bind-Value="availabilityRule.EndDate" />
                        <div class="rate-engine-checkboxes">
                            <label><input type="checkbox" @bind="availabilityRule.StopSell" /> @L["Stop sell"]</label>
                            <label><input type="checkbox" @bind="availabilityRule.ClosedToArrival" /> @L["Closed to arrival"]</label>
                            <label><input type="checkbox" @bind="availabilityRule.ClosedToDeparture" /> @L["Closed to departure"]</label>
                        </div>
                        <InputNumber class="form-control" @bind-Value="availabilityRule.MinStayNights" />
                    </div>
                    <button type="button" class="btn btn-outline-primary" @onclick="AddAvailabilityRuleAsync" disabled="@isExecutingRateEngine">
                        @L["Save availability rule"]
                    </button>
                </div>
            </div>

            @if (rateAvailabilitySnapshot is not null)
            {
                <div class="rate-engine-ledger">
                    <div>
                        <h3>@L["Rate rules"]</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@L["Room type"]</th>
                                    <th>@L["Period"]</th>
                                    <th>@L["Occupancy"]</th>
                                    <th class="text-end">@L["Net / night"]</th>
                                    <th>@L["VAT"]</th>
                                    <th>@L["Priority"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rule in rateAvailabilitySnapshot.RateRules)
                                {
                                    <tr>
                                        <td>@rule.RoomType</td>
                                        <td>@rule.StartDate.ToString("dd.MM.yyyy") - @rule.EndDate.ToString("dd.MM.yyyy")</td>
                                        <td>@BuildOccupancyRange(rule.OccupancyFrom, rule.OccupancyTo)</td>
                                        <td class="text-end">@FormatCurrency(rule.NightlyNetAmount)</td>
                                        <td>@rule.VatRatePercent.ToString("0.##")%</td>
                                        <td>@rule.Priority</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div>
                        <h3>@L["Availability rules"]</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@L["Scope"]</th>
                                    <th>@L["Period"]</th>
                                    <th>@L["Constraints"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rule in rateAvailabilitySnapshot.AvailabilityRules)
                                {
                                    <tr>
                                        <td>@BuildAvailabilityScope(rule)</td>
                                        <td>@rule.StartDate.ToString("dd.MM.yyyy") - @rule.EndDate.ToString("dd.MM.yyyy")</td>
                                        <td>@BuildAvailabilityConstraintLabel(rule)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    }

    @if (editor is not null && snapshot is not null)
    {
        <section class="reservation-editor">
            <div class="reservation-editor-header">
                <h2>@(editor.ReservationId is null ? L["Create reservation"] : L["Edit reservation"])</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseEditor" disabled="@isExecutingAction">@L["Close"]</button>
            </div>

            <div class="reservation-editor-grid">
                <div>
                    <label class="form-label" for="editor-room">@L["Room"]</label>
                    <select id="editor-room" class="form-select" @bind="editor.RoomId" disabled="@isExecutingAction">
                        @foreach (var room in snapshot.Rooms)
                        {
                            <option value="@room.RoomId">@room.RoomNumber · @room.RoomType</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="editor-guest">@L["Guest / block name"]</label>
                    <input id="editor-guest" class="form-control" @bind="editor.GuestName" disabled="@isExecutingAction" />
                </div>
                <div>
                    <label class="form-label" for="editor-checkin">@L["Check-in"]</label>
                    <InputDate id="editor-checkin" class="form-control" @bind-Value="editor.CheckIn" disabled="@isExecutingAction" />
                </div>
                <div>
                    <label class="form-label" for="editor-checkout">@L["Check-out"]</label>
                    <InputDate id="editor-checkout" class="form-control" @bind-Value="editor.CheckOut" disabled="@isExecutingAction" />
                </div>
                <div>
                    <label class="form-label" for="editor-status">@L["Status"]</label>
                    <InputSelect id="editor-status" class="form-select" @bind-Value="editor.Status" disabled="@isExecutingAction">
                        <option value="@ReservationStatus.Confirmed">@GetStatusLabel(ReservationStatus.Confirmed)</option>
                        <option value="@ReservationStatus.Maintenance">@GetStatusLabel(ReservationStatus.Maintenance)</option>
                        <option value="@ReservationStatus.Blocked">@GetStatusLabel(ReservationStatus.Blocked)</option>
                        <option value="@ReservationStatus.CheckedIn">@GetStatusLabel(ReservationStatus.CheckedIn)</option>
                    </InputSelect>
                </div>
                <div>
                    <label class="form-label" for="editor-occupancy">@L["Occupancy"]</label>
                    <InputNumber id="editor-occupancy" class="form-control" @bind-Value="editor.Occupancy" disabled="@isExecutingAction" />
                </div>
                <div class="editor-notes">
                    <label class="form-label" for="editor-notes">@L["Notes"]</label>
                    <textarea id="editor-notes" class="form-control" rows="2" @bind="editor.Notes" disabled="@isExecutingAction"></textarea>
                </div>
            </div>

            @if (editor.CheckOut <= editor.CheckIn)
            {
                <div class="editor-validation-error">@L["Check-out must be after check-in."]</div>
            }
            else if (editor.Occupancy <= 0)
            {
                <div class="editor-validation-error">@L["Occupancy must be greater than 0."]</div>
            }

            <section class="rate-quote-section">
                <div class="rate-quote-header">
                    <h3>@L["Rate quote"]</h3>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="RefreshRateQuoteAsync"
                            disabled="@(isExecutingAction || editor.CheckOut <= editor.CheckIn || editor.Occupancy <= 0)">
                        @L["Calculate stay price"]
                    </button>
                </div>

                @if (rateQuoteError is not null)
                {
                    <div class="alert alert-warning" role="alert">@rateQuoteError</div>
                }
                else if (rateQuote is not null)
                {
                    <div class="rate-quote-kpis">
                        <div>
                            <div class="rate-quote-value">@rateQuote.Nights</div>
                            <div class="rate-quote-label">@L["Nights"]</div>
                        </div>
                        <div>
                            <div class="rate-quote-value">@FormatCurrency(rateQuote.NetAmount)</div>
                            <div class="rate-quote-label">@L["Net total"]</div>
                        </div>
                        <div>
                            <div class="rate-quote-value">@FormatCurrency(rateQuote.VatAmount)</div>
                            <div class="rate-quote-label">@L["VAT total"]</div>
                        </div>
                        <div>
                            <div class="rate-quote-value">@FormatCurrency(rateQuote.GrossAmount)</div>
                            <div class="rate-quote-label">@L["Gross total"]</div>
                        </div>
                    </div>
                }
            </section>

            <div class="reservation-editor-actions">
                <button type="button"
                        class="btn btn-success"
                        @onclick="SaveReservationAsync"
                        disabled="@(isExecutingAction || editor.CheckOut <= editor.CheckIn || editor.Occupancy <= 0)">
                    @L["Save"]
                </button>

                @if (editor.ReservationId is not null)
                {
                    <button type="button"
                            class="btn btn-outline-success"
                            @onclick="CheckInReservationAsync"
                            disabled="@(isExecutingAction || editor.Status != ReservationStatus.Confirmed)">
                        @L["Check in"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-dark"
                            @onclick="CheckOutReservationAsync"
                            disabled="@(isExecutingAction || editor.Status != ReservationStatus.CheckedIn)">
                        @L["Check out"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            @onclick="CancelReservationAsync"
                            disabled="@(isExecutingAction || editor.Status is ReservationStatus.CheckedOut or ReservationStatus.Cancelled)">
                        @L["Cancel"]
                    </button>
                }
            </div>

            @if (editor.ReservationId is not null)
            {
                <section class="billing-section">
                    <h3>@L["Billing & Invoicing (AT / EU)"]</h3>

                    @if (billingError is not null)
                    {
                        <div class="alert alert-danger" role="alert">@billingError</div>
                    }
                    else if (billingMessage is not null)
                    {
                        <div class="alert alert-success" role="alert">@billingMessage</div>
                    }

                    @if (isLoadingBilling || billingSnapshot is null || billingReservationId != editor.ReservationId)
                    {
                        <p><em>@L["Loading billing data..."]</em></p>
                    }
                    else
                    {
                        <div class="billing-kpis">
                            <div class="billing-kpi-card">
                                <div class="billing-kpi-value">@FormatCurrency(billingSnapshot.NetAmount)</div>
                                <div class="billing-kpi-label">@L["Net"]</div>
                            </div>
                            <div class="billing-kpi-card">
                                <div class="billing-kpi-value">@FormatCurrency(billingSnapshot.VatAmount)</div>
                                <div class="billing-kpi-label">@L["VAT"]</div>
                            </div>
                            <div class="billing-kpi-card">
                                <div class="billing-kpi-value">@FormatCurrency(billingSnapshot.GrossAmount)</div>
                                <div class="billing-kpi-label">@L["Gross"]</div>
                            </div>
                            <div class="billing-kpi-card">
                                <div class="billing-kpi-value">@FormatCurrency(billingSnapshot.OpenAmount)</div>
                                <div class="billing-kpi-label">@L["Open"]</div>
                            </div>
                        </div>

                        <div class="billing-grid">
                            <div class="billing-card">
                                <h4>@L["Add folio entry"]</h4>
                                <div class="billing-form-grid">
                                    <input class="form-control" placeholder="@L["Description"]" @bind="billingEntry.Description" />
                                    <InputSelect class="form-select" @bind-Value="billingEntry.EntryType">
                                        <option value="@FolioEntryType.Charge">@L["Charge"]</option>
                                        <option value="@FolioEntryType.Credit">@L["Credit"]</option>
                                    </InputSelect>
                                    <InputNumber class="form-control" @bind-Value="billingEntry.Quantity" />
                                    <InputNumber class="form-control" @bind-Value="billingEntry.UnitNetAmount" />
                                    <InputSelect class="form-select" @bind-Value="billingEntry.VatRatePercent">
                                        <option value="20">20%</option>
                                        <option value="13">13%</option>
                                        <option value="10">10%</option>
                                        <option value="0">0%</option>
                                    </InputSelect>
                                    <InputDate class="form-control" @bind-Value="billingEntry.ServiceDate" />
                                    <input class="form-control billing-wide-input"
                                           placeholder="@L["Tax exemption reason (required for 0% VAT)"]"
                                           @bind="billingEntry.TaxExemptionReason" />
                                </div>
                                <button type="button" class="btn btn-outline-primary" @onclick="AddFolioEntryAsync" disabled="@isExecutingBilling">
                                    @L["Add entry"]
                                </button>
                            </div>

                            <div class="billing-card">
                                <h4>@L["Register payment"]</h4>
                                <div class="billing-form-grid">
                                    <InputNumber class="form-control" @bind-Value="billingPayment.Amount" />
                                    <InputSelect class="form-select" @bind-Value="billingPayment.Method">
                                        <option value="@PaymentMethod.Card">@L["Card"]</option>
                                        <option value="@PaymentMethod.BankTransfer">@L["Bank transfer"]</option>
                                        <option value="@PaymentMethod.Online">@L["Online"]</option>
                                        <option value="@PaymentMethod.Cash">@L["Cash"]</option>
                                        <option value="@PaymentMethod.Voucher">@L["Voucher"]</option>
                                    </InputSelect>
                                    <input class="form-control billing-wide-input" placeholder="@L["Reference"]" @bind="billingPayment.Reference" />
                                </div>
                                <button type="button" class="btn btn-outline-success" @onclick="RegisterPaymentAsync" disabled="@isExecutingBilling">
                                    @L["Post payment"]
                                </button>
                            </div>

                            <div class="billing-card">
                                <h4>@L["Issue invoice"]</h4>
                                <div class="billing-form-grid">
                                    <input class="form-control" placeholder="@L["Buyer name"]" @bind="billingInvoice.BuyerName" />
                                    <input class="form-control" placeholder="@L["Buyer address"]" @bind="billingInvoice.BuyerAddress" />
                                    <input class="form-control" placeholder="@L["Buyer VAT ID (optional)"]" @bind="billingInvoice.BuyerVatId" />
                                    <InputDate class="form-control" @bind-Value="billingInvoice.DueDate" />
                                </div>
                                <button type="button" class="btn btn-outline-dark" @onclick="IssueInvoiceAsync" disabled="@isExecutingBilling">
                                    @L["Issue invoice"]
                                </button>
                            </div>
                        </div>

                        <div class="billing-ledger">
                            <div>
                                <h4>@L["Folio entries"]</h4>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L["Date"]</th>
                                            <th>@L["Description"]</th>
                                            <th>@L["VAT"]</th>
                                            <th class="text-end">@L["Gross"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in billingSnapshot.Entries.OrderByDescending(item => item.ServiceDate))
                                        {
                                            <tr>
                                                <td>@entry.ServiceDate.ToString("dd.MM.yyyy")</td>
                                                <td>@entry.Description</td>
                                                <td>@entry.VatRatePercent.ToString("0.##")%</td>
                                                <td class="text-end">@FormatCurrency(entry.GrossAmount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div>
                                <h4>@L["Payments"]</h4>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L["Date"]</th>
                                            <th>@L["Method"]</th>
                                            <th class="text-end">@L["Amount"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var payment in billingSnapshot.Payments)
                                        {
                                            <tr>
                                                <td>@payment.PaidAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@GetPaymentMethodLabel(payment.Method)</td>
                                                <td class="text-end">@FormatCurrency(payment.Amount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>
            }
        </section>
    }

    <div class="planner-legend">
        @foreach (var status in legendStatuses)
        {
            <div class="legend-item">
                <span class="legend-badge @GetStatusClass(status)"></span>
                <span>@GetStatusLabel(status)</span>
            </div>
        }
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger" role="alert">
            @L["Failed to load room planner data: {0}", loadError]
        </div>
    }
    else if (snapshot is null)
    {
        <p><em>@L["Loading room planner..."]</em></p>
    }
    else
    {
        <div class="planner-board">
            <div class="planner-top-row">
                <div class="room-column-header">@L["Room"]</div>
                <div class="timeline-header" style="@TimelineColumnsStyle">
                    @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                    {
                        var day = snapshot.StartDate.AddDays(dayOffset);
                        <div class="@GetDayHeaderClass(day)">
                            <span class="day-name">@day.ToString("ddd")</span>
                            <span class="day-date">@day.ToString("dd MMM")</span>
                        </div>
                    }
                </div>
            </div>

            @foreach (var room in FilteredRooms)
            {
                <div class="planner-room-row">
                    <div class="room-card">
                        <div class="room-number">@room.RoomNumber</div>
                        <div class="room-type">@room.RoomType</div>
                        <div class="room-floor">@L["Floor {0}", room.Floor]</div>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary room-action-btn"
                                @onclick="() => StartCreateReservation(room.RoomId)">
                            + @L["Reservation"]
                        </button>
                    </div>

                    <div class="@GetTimelineRowClass(room.RoomId)" style="@TimelineColumnsStyle">
                        @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                        {
                            var day = snapshot.StartDate.AddDays(dayOffset);
                            <div class="@GetDayCellClass(day, room.RoomId)"
                                 @ondragenter="() => SetDragTarget(room.RoomId, day)"
                                 @ondragleave="() => ClearDragTarget(room.RoomId, day)"
                                 @ondrop="() => DropReservationAsync(room.RoomId, day)"
                                 @ondragover:preventDefault></div>
                        }

                        @foreach (var reservation in room.Reservations)
                        {
                            var placement = GetPlacement(reservation);
                            if (placement is null)
                            {
                                continue;
                            }

                            <button type="button"
                                    class="@GetReservationChipClass(reservation)"
                                    style="grid-column: @($"{placement.Value.Start} / span {placement.Value.Span}")"
                                    title="@BuildReservationTitle(reservation)"
                                    draggable="true"
                                    @ondragstart="() => StartReservationMoveDrag(room.RoomId, reservation)"
                                    @ondragend="EndReservationDrag"
                                    @onclick="() => StartEditReservationAsync(room.RoomId, reservation)">
                                <span class="reservation-resize-handle reservation-resize-handle-start"
                                      title="@L["Drag to change check-in date"]"
                                      draggable="true"
                                      @ondragstart:stopPropagation="true"
                                      @ondragstart="() => StartReservationResizeDrag(room.RoomId, reservation, true)"
                                      @ondragend="EndReservationDrag"
                                      @onclick:stopPropagation="true">
                                </span>
                                <span class="reservation-guest">@reservation.GuestName</span>
                                <span class="reservation-dates">@reservation.CheckIn.ToString("dd MMM") - @reservation.CheckOut.ToString("dd MMM")</span>
                                <span class="reservation-resize-handle reservation-resize-handle-end"
                                      title="@L["Drag to change check-out date"]"
                                      draggable="true"
