            billingReservationId = billingSnapshot.ReservationId;
            billingMessage = successMessage;
            ResetBillingForms();
        }
        catch (BillingValidationException exception)
        {
            billingError = exception.Message;
        }
        catch (BillingConflictException exception)
        {
            billingError = exception.Message;
        }
        catch (BillingNotFoundException exception)
        {
            billingError = exception.Message;
        }
        finally
        {
            isExecutingBilling = false;
        }
    }

    private void ResetBillingForms()
    {
        billingEntry = new BillingEntryModel
        {
            Description = string.Empty,
            EntryType = FolioEntryType.Charge,
            Quantity = 1m,
            UnitNetAmount = 0m,
            VatRatePercent = 10m,
            ServiceDate = DateOnly.FromDateTime(DateTime.UtcNow),
            TaxExemptionReason = null
        };

        billingPayment = new BillingPaymentModel
        {
            Amount = 0m,
            Method = PaymentMethod.Card,
            Reference = null
        };

        billingInvoice.DueDate = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(14);
    }

    private void EnsureRateEngineDefaults()
    {
        var firstRoomType = RoomTypeOptions.FirstOrDefault() ?? string.Empty;
        var firstRoom = snapshot?.Rooms.FirstOrDefault();

        if (string.IsNullOrWhiteSpace(rateRule.RoomType))
        {
            rateRule.RoomType = firstRoomType;
        }

        if (rateRule.StartDate == default)
        {
            rateRule.StartDate = viewStartDate;
        }

        if (rateRule.EndDate <= rateRule.StartDate)
        {
            rateRule.EndDate = rateRule.StartDate.AddDays(1);
        }

        if (availabilityRule.StartDate == default)
        {
            availabilityRule.StartDate = viewStartDate;
        }

        if (availabilityRule.EndDate <= availabilityRule.StartDate)
        {
            availabilityRule.EndDate = availabilityRule.StartDate.AddDays(1);
        }

        if (string.IsNullOrWhiteSpace(availabilityRule.RoomType))
        {
            availabilityRule.RoomType = firstRoomType;
        }

        if (availabilityRule.RoomId is null && firstRoom is not null)
        {
            availabilityRule.RoomId = firstRoom.RoomId;
        }
    }

    private void ClearOperationMessages()
    {
        operationError = null;
        operationMessage = null;
    }

    private string GetPaymentMethodLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Cash => L["Cash"],
        PaymentMethod.Card => L["Card"],
        PaymentMethod.BankTransfer => L["Bank transfer"],
        PaymentMethod.Online => L["Online"],
        PaymentMethod.Voucher => L["Voucher"],
        _ => method.ToString()
    };

    private static string FormatCurrency(decimal amount)
    {
        return amount.ToString("C", CultureInfo.CurrentCulture);
    }

    private string BuildOccupancyRange(int occupancyFrom, int? occupancyTo)
    {
        return occupancyTo is null || occupancyTo == occupancyFrom
            ? occupancyFrom.ToString(CultureInfo.InvariantCulture)
            : $"{occupancyFrom}-{occupancyTo.Value}";
    }

    private string BuildAvailabilityScope(RoomAvailabilityRuleDto rule)
    {
        if (rule.RoomId is not null)
        {
            return string.IsNullOrWhiteSpace(rule.RoomNumber)
                ? L["Room-specific"]
                : L["Room {0}", rule.RoomNumber];
        }

        return string.IsNullOrWhiteSpace(rule.RoomType)
            ? L["Room type"]
            : $"{L["Room type"]}: {rule.RoomType}";
    }

    private string BuildAvailabilityConstraintLabel(RoomAvailabilityRuleDto rule)
    {
        var constraints = new List<string>();
        if (rule.StopSell)
        {
            constraints.Add(L["Stop sell"]);
        }

        if (rule.ClosedToArrival)
        {
            constraints.Add(L["Closed to arrival"]);
        }

        if (rule.ClosedToDeparture)
        {
            constraints.Add(L["Closed to departure"]);
        }

        if (rule.MinStayNights is not null)
        {
            constraints.Add(L["Min stay {0} nights", rule.MinStayNights.Value]);
        }

        return constraints.Count == 0 ? "-" : string.Join(", ", constraints);
    }

    private string GetRoomLabel(Guid roomId)
    {
        var room = snapshot?.Rooms.FirstOrDefault(item => item.RoomId == roomId);
        return room?.RoomNumber ?? roomId.ToString();
    }

    private void ClearDragState()
    {
        dragReservation = null;
        dragTargetRoomId = null;
        dragTargetDate = null;
    }

    private bool RoomMatchesFilters(RoomPlannerRoom room)
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();
            var roomMatches = room.RoomNumber.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                              room.RoomType.Contains(search, StringComparison.OrdinalIgnoreCase);
            var guestMatches = room.Reservations.Any(reservation =>
                reservation.GuestName.Contains(search, StringComparison.OrdinalIgnoreCase));

            if (!roomMatches && !guestMatches)
            {
                return false;
            }
        }

        return statusFilter switch
        {
            "checkedin" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.CheckedIn),
            "confirmed" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.Confirmed),
            "maintenance" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.Maintenance),
            "blocked" => room.Reservations.Any(reservation => reservation.Status == ReservationStatus.Blocked),
            _ => true
        };
    }

    private int GetInHouseCount()
    {
        if (snapshot is null)
        {
            return 0;
        }

        return snapshot.Rooms.Count(room => room.Reservations.Any(reservation =>
            reservation.Status == ReservationStatus.CheckedIn &&
            reservation.CheckIn <= viewStartDate &&
            reservation.CheckOut > viewStartDate));
    }

    private int GetArrivalsCount()
    {
        if (snapshot is null)
        {
            return 0;
        }

        return snapshot.Rooms.Sum(room => room.Reservations.Count(reservation => reservation.CheckIn == viewStartDate));
    }

    private int GetDeparturesCount()
    {
        if (snapshot is null)
        {
            return 0;
        }

        return snapshot.Rooms.Sum(room => room.Reservations.Count(reservation => reservation.CheckOut == viewStartDate));
    }

