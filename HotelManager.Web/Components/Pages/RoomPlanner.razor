    private readonly record struct DaySummary(int Free, int Occupied, int OutOfOrder, int OccupancyPercent);

    private static DaySummary GetDaySummary(IReadOnlyList<RoomPlannerRoom> rooms, DateOnly day)
    {
        var occupied = 0;
        var outOfOrder = 0;

        foreach (var room in rooms)
        {
            var active = room.Reservations.FirstOrDefault(r =>
                r.Status != ReservationStatus.Cancelled && r.CheckIn <= day && r.CheckOut > day);

            if (active is null)
            {
                continue;
            }

            if (active.Status is ReservationStatus.Maintenance or ReservationStatus.Blocked)
            {
                outOfOrder++;
            }
            else
            {
                occupied++;
            }
        }

        var sellable = rooms.Count - outOfOrder;
        var percent = sellable > 0 ? (int)Math.Round(occupied * 100.0 / sellable) : 0;
        return new DaySummary(sellable - occupied, occupied, outOfOrder, percent);
    }

    private static string GetSummaryCellClass(DaySummary summary) => summary.OccupancyPercent switch
    {
        >= 90 => "summary-cell summary-high",
        >= 60 => "summary-cell summary-medium",
        _ => "summary-cell summary-low"
    };

    [JSInvokable]
    public void OnCreateRangeSelected(string roomId, string checkIn, string checkOut)
    {
        if (isExecutingAction
            || !Guid.TryParse(roomId, out var parsedRoomId)
            || !DateOnly.TryParseExact(checkIn, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedCheckIn)
            || !DateOnly.TryParseExact(checkOut, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedCheckOut)
            || parsedCheckOut <= parsedCheckIn)
        {
            return;
        }

        StartCreateReservation(parsedRoomId);
        editor!.CheckIn = parsedCheckIn;
        editor.CheckOut = parsedCheckOut;
        scrollEditorTarget = ".reservation-editor";
        StateHasChanged();
    }

