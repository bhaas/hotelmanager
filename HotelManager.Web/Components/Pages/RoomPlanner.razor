    private int? EditorMaxOccupancy =>
        editor is not null
        && editor.Status is not (ReservationStatus.Blocked or ReservationStatus.Maintenance)
        && snapshot?.Rooms.FirstOrDefault(room => room.RoomId == editor.RoomId) is { MaxOccupancy: > 0 } room
            ? room.MaxOccupancy
            : null;

    private string GetRoomCardTitle(RoomPlannerRoom room)
    {
        var parts = new List<string> { room.RoomType, L["Floor {0}", room.Floor], GetHousekeepingLabel(room.HousekeepingStatus) };
