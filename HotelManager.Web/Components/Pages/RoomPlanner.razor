    protected override Task OnInitializedAsync()
    {
        return ReloadAsync();
    }

    private async Task ShiftWindowAsync(int direction)
    {
        viewStartDate = viewStartDate.AddDays(direction * daysToShow);
        await ReloadAsync();
    }

    private async Task JumpToTodayAsync()
    {
        viewStartDate = DateOnly.FromDateTime(DateTime.UtcNow);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            snapshot = await RoomPlannerQueryService.GetSnapshotAsync(viewStartDate, daysToShow, CancellationToken.None);
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string TimelineColumnsStyle => $"grid-template-columns: repeat({daysToShow}, minmax({zoomDayWidths[zoomLevel]}px, 1fr));";

    // Rows use two columns per day so stays can start/end at mid-day (arrival afternoon, departure morning).
    private string HalfDayColumnsStyle => $"grid-template-columns: repeat({daysToShow * 2}, minmax({zoomDayWidths[zoomLevel] / 2}px, 1fr));";

    private void ChangeZoom(int delta)
    {
        zoomLevel = Math.Clamp(zoomLevel + delta, 0, zoomDayWidths.Length - 1);
    }

    [JSInvokable]
    public void OnZoomRequested(int delta)
    {
        var previous = zoomLevel;
        ChangeZoom(delta);
        if (previous != zoomLevel)
        {
            StateHasChanged();
        }
    }

    private void OpenContextMenu(MouseEventArgs args, RoomPlannerRoom room, RoomPlannerReservation reservation)
    {
        roomMenu = null;
        contextMenu = new ContextMenuState(
            reservation,
            room.RoomId,
            $"{L["Room"]} {room.RoomNumber} · {room.RoomType}",
            args.ClientX,
            args.ClientY);
        fitContextMenu = true;
    }

    private void CloseContextMenu()
    {
        contextMenu = null;
        roomMenu = null;
    }

    private void OpenRoomMenu(MouseEventArgs args, RoomPlannerRoom room)
    {
        contextMenu = null;
        roomMenu = new RoomMenuState(room, args.ClientX, args.ClientY);
        fitContextMenu = true;
    }

    private async Task SetHousekeepingStatusAsync(HousekeepingStatus status)
    {
        if (roomMenu is null)
        {
            return;
        }

        var room = roomMenu.Room;
        roomMenu = null;
        if (room.HousekeepingStatus == status)
        {
            return;
        }

        ClearOperationMessages();
        try
        {
            await RoomPlannerCommandService.SetHousekeepingStatusAsync(room.RoomId, status, CancellationToken.None);
            operationMessage = L["Room {0} marked as {1}.", room.RoomNumber, GetHousekeepingLabel(status)];
            await ReloadAsync();
        }
        catch (ReservationNotFoundException exception)
        {
            operationError = exception.Message;
