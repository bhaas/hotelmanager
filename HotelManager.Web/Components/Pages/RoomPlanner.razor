    private async Task AddAvailabilityRuleAsync()
    {
        if (snapshot is null)
        {
            return;
        }

        isExecutingRateEngine = true;
        rateEngineError = null;
        rateEngineMessage = null;

        try
        {
            var roomId = availabilityRule.Scope == "room" ? availabilityRule.RoomId : null;
            var roomType = availabilityRule.Scope == "room" ? null : availabilityRule.RoomType;

            var request = new RoomAvailabilityRuleUpsertRequest(
                roomId,
                roomType,
                availabilityRule.StartDate,
                availabilityRule.EndDate,
                availabilityRule.StopSell,
                availabilityRule.ClosedToArrival,
                availabilityRule.ClosedToDeparture,
                availabilityRule.MinStayNights);

            await RateAvailabilityService.CreateAvailabilityRuleAsync(request, CancellationToken.None);
            rateAvailabilitySnapshot = await RateAvailabilityService.GetSnapshotAsync(viewStartDate, daysToShow, CancellationToken.None);
            rateEngineMessage = L["Availability rule saved."];
