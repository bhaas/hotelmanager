    private Placement? GetPlacement(RoomPlannerReservation reservation)
    {
        var viewEndDate = viewStartDate.AddDays(daysToShow);

        // A departure on the first visible day still shows its morning half.
        if (reservation.CheckOut < viewStartDate || reservation.CheckIn >= viewEndDate)
        {
            return null;
        }

        var checkInOffset = reservation.CheckIn.DayNumber - viewStartDate.DayNumber;
        var checkOutOffset = reservation.CheckOut.DayNumber - viewStartDate.DayNumber;
        var continuesLeft = checkInOffset < 0;
        var continuesRight = checkOutOffset >= daysToShow;
        var lastLine = daysToShow * 2 + 1;

        var startColumn = continuesLeft ? 1 : checkInOffset * 2 + 2;
        var endColumn = continuesRight ? lastLine : checkOutOffset * 2 + 2;

        return endColumn > startColumn
            ? new Placement(startColumn, endColumn, continuesLeft, continuesRight)
            : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("plannerDrag.init", plannerPageElement, dotNetReference);
        }

        if (scrollEditorTarget is not null)
        {
            var target = scrollEditorTarget;
            scrollEditorTarget = null;
            await JS.InvokeVoidAsync("plannerDrag.scrollIntoView", target);
        }

        if (fitContextMenu)
        {
            fitContextMenu = false;
            await JS.InvokeVoidAsync("plannerDrag.fitToViewport", ".context-menu");
        }

        // Success toasts fade out on their own; errors stay until dismissed.
        if (operationMessage is not null && operationError is null && !ReferenceEquals(operationMessage, scheduledToastMessage))
        {
            scheduledToastMessage = operationMessage;
            ScheduleToastDismiss(undoState is null ? 5000 : 10000);
        }
    }

    public async ValueTask DisposeAsync()
    {
        toastTimer?.Cancel();
        toastTimer?.Dispose();
        if (dotNetReference is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("plannerDrag.dispose");
        }
        catch (JSDisconnectedException)
        {
        }

        dotNetReference?.Dispose();
    }

    [JSInvokable]
    public async Task OnReservationDragCompleted(string reservationId, string mode, string roomId, string checkIn, string checkOut)
    {
        if (isExecutingAction || snapshot is null
            || !Guid.TryParse(reservationId, out var parsedReservationId)
            || !Guid.TryParse(roomId, out var newRoomId)
            || !DateOnly.TryParseExact(checkIn, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var newCheckIn)
            || !DateOnly.TryParseExact(checkOut, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var newCheckOut))
        {
            return;
        }

        var sourceRoom = snapshot.Rooms.FirstOrDefault(r => r.Reservations.Any(x => x.ReservationId == parsedReservationId));
        var source = sourceRoom?.Reservations.First(x => x.ReservationId == parsedReservationId);
        if (sourceRoom is null || source is null)
        {
            return;
        }

        ClearOperationMessages();

        if (newCheckOut <= newCheckIn)
        {
            operationError = L["Check-out must be after check-in."];
            StateHasChanged();
            return;
        }

        if (sourceRoom.RoomId == newRoomId && source.CheckIn == newCheckIn && source.CheckOut == newCheckOut)
        {
            return;
        }

        var message = mode == "move" && sourceRoom.RoomId != newRoomId
            ? L["Reservation moved to room {0}.", GetRoomLabel(newRoomId)]
            : mode == "move"
                ? L["Reservation moved to {0} - {1}.", newCheckIn.ToString("dd MMM"), newCheckOut.ToString("dd MMM")]
                : L["Reservation stay updated to {0} - {1}.", newCheckIn.ToString("dd MMM"), newCheckOut.ToString("dd MMM")];

        try
        {
            isExecutingAction = true;
            StateHasChanged();

            var request = new RoomPlannerReservationUpsertRequest(
                newRoomId,
                source.GuestName,
                newCheckIn,
                newCheckOut,
                source.Occupancy,
                source.Status,
                source.Notes);

            await RoomPlannerCommandService.UpdateReservationAsync(source.ReservationId, request, CancellationToken.None);
            operationMessage = message;
            undoState = new UndoState(
                source.ReservationId,
                request with { RoomId = sourceRoom.RoomId, CheckIn = source.CheckIn, CheckOut = source.CheckOut });

            if (editor?.ReservationId == source.ReservationId)
            {
                editor.RoomId = newRoomId;
                editor.CheckIn = newCheckIn;
                editor.CheckOut = newCheckOut;
                rateQuote = null;
                rateQuoteError = null;
                await RefreshRateQuoteAsync();
            }

            await ReloadAsync();
        }
        catch (ReservationValidationException exception)
        {
            operationError = exception.Message;
        }
        catch (ReservationConflictException exception)
        {
            operationError = exception.Message;
        }
        catch (ReservationNotFoundException exception)
        {
            operationError = exception.Message;
        }
        finally
        {
            isExecutingAction = false;
            StateHasChanged();
        }
    }

    private void StartCreateReservation()
    {
        if (snapshot is null || snapshot.Rooms.Count == 0)
        {
            return;
        }

        StartCreateReservation(snapshot.Rooms[0].RoomId);
    }

    private void StartCreateReservation(Guid roomId)
    {
        editor = new ReservationEditorModel
        {
            RoomId = roomId,
            GuestName = string.Empty,
            CheckIn = viewStartDate,
            CheckOut = viewStartDate.AddDays(1),
            Occupancy = 1,
            Status = ReservationStatus.Confirmed,
            Notes = null
        };
        rateQuote = null;
        rateQuoteError = null;
        billingSnapshot = null;
        billingReservationId = null;
        billingError = null;
        billingMessage = null;
        ResetBillingForms();
        ClearOperationMessages();
    }

    private async Task StartEditReservationAsync(Guid roomId, RoomPlannerReservation reservation)
    {
        editor = new ReservationEditorModel
        {
            ReservationId = reservation.ReservationId,
            RoomId = roomId,
            GuestName = reservation.GuestName,
            CheckIn = reservation.CheckIn,
            CheckOut = reservation.CheckOut,
            Occupancy = reservation.Occupancy,
            Status = reservation.Status,
            Notes = reservation.Notes
        };

        rateQuote = null;
        rateQuoteError = null;
        billingInvoice.BuyerName = reservation.GuestName;
        billingInvoice.BuyerAddress = string.Empty;
        billingInvoice.BuyerVatId = null;
        billingInvoice.DueDate = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(14);
        ClearOperationMessages();
        await RefreshRateQuoteAsync();
        await LoadBillingAsync(reservation.ReservationId);
    }

    private void CloseEditor()
    {
        editor = null;
        isExecutingAction = false;
        billingSnapshot = null;
        billingReservationId = null;
        billingError = null;
        billingMessage = null;
        rateQuote = null;
        rateQuoteError = null;
    }

    private async Task SaveReservationAsync()
    {
        if (editor is null)
        {
            return;
        }

        if (editor.CheckOut <= editor.CheckIn)
        {
            operationError = L["Check-out must be after check-in."];
            operationMessage = null;
            return;
        }

        if (editor.Occupancy <= 0)
        {
            operationError = L["Occupancy must be greater than 0."];
            operationMessage = null;
            return;
        }

        var request = new RoomPlannerReservationUpsertRequest(
            editor.RoomId,
            editor.GuestName,
            editor.CheckIn,
            editor.CheckOut,
            editor.Occupancy,
            editor.Status,
            editor.Notes);

        if (editor.ReservationId is null)
        {
            await ExecuteReservationActionAsync(
                () => RoomPlannerCommandService.CreateReservationAsync(request, CancellationToken.None),
                L["Reservation created."]);
            return;
        }

        var reservationId = editor.ReservationId.Value;
        await ExecuteReservationActionAsync(
            () => RoomPlannerCommandService.UpdateReservationAsync(reservationId, request, CancellationToken.None),
            L["Reservation updated."]);
    }

    private async Task CheckInReservationAsync()
    {
        if (editor?.ReservationId is null)
        {
            return;
        }

        await ExecuteReservationActionAsync(
            () => RoomPlannerCommandService.CheckInAsync(editor.ReservationId.Value, CancellationToken.None),
            L["Reservation checked in."]);
    }

    private async Task CheckOutReservationAsync()
    {
