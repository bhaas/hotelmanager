    private Placement? GetPlacement(RoomPlannerReservation reservation)
    {
        var viewEndDate = viewStartDate.AddDays(daysToShow);
        var startOffset = Math.Max(0, reservation.CheckIn.DayNumber - viewStartDate.DayNumber);
        var endOffset = Math.Min(daysToShow, reservation.CheckOut.DayNumber - viewStartDate.DayNumber);
        var span = endOffset - startOffset;

        if (reservation.CheckOut <= viewStartDate || reservation.CheckIn >= viewEndDate || span <= 0)
        {
            return null;
        }

        return new Placement(startOffset + 1, span);
    }

