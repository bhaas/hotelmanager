    private async Task IssueInvoiceAsync()
    {
        if (editor?.ReservationId is null)
        {
            return;
        }

        var request = new BillingIssueInvoiceRequest(
            billingInvoice.BuyerName,
            billingInvoice.BuyerAddress,
            billingInvoice.BuyerVatId,
            billingInvoice.DueDate);

        isExecutingBilling = true;
        billingError = null;
        billingMessage = null;
        BillingInvoiceDocumentDto? issuedInvoice = null;

        try
        {
            issuedInvoice = await BillingService.IssueInvoiceAsync(editor.ReservationId.Value, request, CancellationToken.None);
            await JS.InvokeVoidAsync("invoiceExport.openPdfInNewTab", $"/api/billing/invoices/{issuedInvoice.InvoiceId}/pdf");
            await LoadBillingAsync(editor.ReservationId.Value);
            billingMessage = L["Invoice {0} issued and opened.", issuedInvoice.InvoiceNumber];
        }
        catch (BillingValidationException exception)
        {
            billingError = exception.Message;
        }
        catch (BillingConflictException exception)
        {
            billingError = exception.Message;
        }
        catch (BillingNotFoundException exception)
        {
            billingError = exception.Message;
        }
        catch (JSException)
        {
            if (issuedInvoice is not null)
            {
                await JS.InvokeVoidAsync(
                    "invoiceExport.triggerBrowserDownload",
                    $"/api/billing/invoices/{issuedInvoice.InvoiceId}/pdf?download=true",
                    $"{issuedInvoice.InvoiceNumber}.pdf");
                billingMessage = L["Invoice {0} issued and downloaded via browser fallback.", issuedInvoice.InvoiceNumber];
            }
            else
            {
                billingError = L["The invoice PDF could not be opened automatically."];
            }
        }
        finally
        {
            isExecutingBilling = false;
        }
    }

    private async Task ExecuteBillingActionAsync(
        Func<Task<BillingFolioSnapshot>> action,
        string successMessage)
    {
        isExecutingBilling = true;
        billingError = null;
        billingMessage = null;

        try
