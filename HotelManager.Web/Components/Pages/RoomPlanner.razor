        }

        return dragReservation.Mode == DragMode.Move || dragReservation.RoomId == roomId;
    }

    private (Guid RoomId, DateOnly CheckIn, DateOnly CheckOut, string Message) ResolveDropResult(
        DragReservationContext source,
        Guid roomId,
        DateOnly day)
    {
        switch (source.Mode)
        {
            case DragMode.ResizeStart:
                if (roomId != source.RoomId)
                {
                    throw new ReservationValidationException(L["Drop resize handle on the same room row."]);
                }

                return (
                    source.RoomId,
                    day,
                    source.CheckOut,
                    L["Reservation stay updated to {0} - {1}.", day.ToString("dd MMM"), source.CheckOut.ToString("dd MMM")]);

            case DragMode.ResizeEnd:
                if (roomId != source.RoomId)
                {
                    throw new ReservationValidationException(L["Drop resize handle on the same room row."]);
                }

                var adjustedCheckout = day.AddDays(1);
                return (
                    source.RoomId,
                    source.CheckIn,
                    adjustedCheckout,
                    L["Reservation stay updated to {0} - {1}.", source.CheckIn.ToString("dd MMM"), adjustedCheckout.ToString("dd MMM")]);

            default:
                var nights = source.CheckOut.DayNumber - source.CheckIn.DayNumber;
                return (
                    roomId,
                    day,
                    day.AddDays(nights),
                    L["Reservation moved to room {0}.", GetRoomLabel(roomId)]);
        }
    }

