@page "/room-planner"
@using System.Globalization
@rendermode InteractiveServer
@inject IRoomPlannerQueryService RoomPlannerQueryService
@inject IRoomPlannerCommandService RoomPlannerCommandService
@inject IRateAvailabilityService RateAvailabilityService
@inject IBillingService BillingService
@inject IStringLocalizer<RoomPlanner> L
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@L["Room Planner"]</PageTitle>

<div class="planner-page @(editor is not null && snapshot is not null ? "drawer-open" : null)" @ref="plannerPageElement">
    <header class="planner-header">
        <div>
            <h1>@L["Room Planner"]</h1>
            <p class="planner-subtitle">@L["High-density planning board inspired by modern hotel operations dashboards."]</p>
        </div>
        <div class="planner-controls">
            <button class="btn btn-outline-secondary" @onclick='() => ShiftWindowAsync(-1)' disabled="@isLoading">← @L["Previous"]</button>
            <button class="btn btn-outline-secondary" @onclick="JumpToTodayAsync" disabled="@isLoading">@L["Today"]</button>
            <button class="btn btn-outline-secondary" @onclick='() => ShiftWindowAsync(1)' disabled="@isLoading">@L["Next"] →</button>
            <button class="btn btn-primary"
                    @onclick="StartCreateReservation"
                    disabled="@(isLoading || snapshot is null || snapshot.Rooms.Count == 0)">
                + @L["New reservation"]
            </button>
            <label class="days-label" for="days-window">@L["Window"]</label>
            <select id="days-window" class="form-select days-select" @bind="daysToShow" @bind:after="ReloadAsync" disabled="@isLoading">
                <option value="7">@L["{0} days", 7]</option>
                <option value="14">@L["{0} days", 14]</option>
                <option value="21">@L["{0} days", 21]</option>
                <option value="31">@L["{0} days", 31]</option>
                <option value="60">@L["{0} days", 60]</option>
                <option value="90">@L["{0} days", 90]</option>
            </select>
            <input class="form-control room-search"
                   type="search"
                   placeholder="@L["Search room, type, or guest"]"
                   @bind="searchText" />
            <select class="form-select status-filter" @bind="statusFilter">
                <option value="all">@L["All statuses"]</option>
                <option value="checkedin">@GetStatusLabel(ReservationStatus.CheckedIn)</option>
                <option value="confirmed">@GetStatusLabel(ReservationStatus.Confirmed)</option>
                <option value="maintenance">@GetStatusLabel(ReservationStatus.Maintenance)</option>
                <option value="blocked">@GetStatusLabel(ReservationStatus.Blocked)</option>
                <option value="dirty">@L["Rooms to clean"]</option>
            </select>
        </div>
    </header>

    @if (snapshot is not null)
    {
        <div class="planner-kpis">
            <div class="kpi-card">
                <div class="kpi-value">@snapshot.Rooms.Count</div>
                <div class="kpi-label">@L["Rooms in planner"]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-value">@GetInHouseCount()</div>
                <div class="kpi-label">@L["In house ({0})", viewStartDate.ToString("dd MMM")]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-value">@GetArrivalsCount()</div>
                <div class="kpi-label">@L["Arrivals ({0})", viewStartDate.ToString("dd MMM")]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-value">@GetDeparturesCount()</div>
                <div class="kpi-label">@L["Departures ({0})", viewStartDate.ToString("dd MMM")]</div>
            </div>
        </div>
    }

    <div class="planner-toolbar">
        <div class="planner-legend">
            @foreach (var status in legendStatuses)
            {
                <div class="legend-item">
                    <span class="legend-badge @GetStatusClass(status)"></span>
                    <span>@GetStatusLabel(status)</span>
                </div>
            }
            <span class="legend-separator" aria-hidden="true"></span>
            @foreach (var housekeepingStatus in housekeepingStatuses)
            {
                <div class="legend-item">
                    <span class="hk-dot @GetHousekeepingClass(housekeepingStatus)"></span>
                    <span>@GetHousekeepingLabel(housekeepingStatus)</span>
                </div>
            }
        </div>
        <div class="planner-toolbar-right">
            <span class="planner-hint">@L["Tip: drag across empty days to create a reservation. Right-click a reservation for actions."]</span>
            <label class="group-by-label" for="group-by">@L["Group"]</label>
            <select id="group-by" class="form-select form-select-sm group-by-select" @bind="groupBy">
                <option value="none">@L["No grouping"]</option>
                <option value="floor">@L["By floor"]</option>
                <option value="type">@L["By room type"]</option>
            </select>
            <div class="btn-group btn-group-sm" role="group" aria-label="@L["Zoom"]">
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="@L["Zoom out (Ctrl + mouse wheel)"]"
                        disabled="@(zoomLevel == 0)"
                        @onclick="() => ChangeZoom(-1)">−</button>
                <span class="btn btn-outline-secondary disabled zoom-label">@L["Zoom"] @(zoomLevel + 1)/@zoomDayWidths.Length</span>
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="@L["Zoom in (Ctrl + mouse wheel)"]"
                        disabled="@(zoomLevel == zoomDayWidths.Length - 1)"
                        @onclick="() => ChangeZoom(1)">+</button>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="@L["Row density"]">
                <button type="button"
                        class="btn @(compactRows ? "btn-secondary" : "btn-outline-secondary")"
                        @onclick="() => compactRows = true">@L["Compact"]</button>
                <button type="button"
                        class="btn @(compactRows ? "btn-outline-secondary" : "btn-secondary")"
                        @onclick="() => compactRows = false">@L["Comfortable"]</button>
            </div>
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger" role="alert">
            @L["Failed to load room planner data: {0}", loadError]
        </div>
    }
    else if (snapshot is null)
    {
        <p><em>@L["Loading room planner..."]</em></p>
    }
    else
    {
        var visibleRooms = FilteredRooms.ToList();
        <div class="planner-board @(compactRows ? "planner-compact" : "planner-comfortable") zoom-@zoomLevel"
             data-label-nights="@L["{0} nights"]"
             data-label-night="@L["{0} night"]"
             data-label-guests="@L["guests"]"
             data-label-room="@L["Room"]">
            <div class="planner-top-row">
                <div class="room-column-header">@L["Room"]</div>
                <div class="timeline-header" style="@TimelineColumnsStyle">
                    @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                    {
                        var day = snapshot.StartDate.AddDays(dayOffset);
                        <div class="@GetDayHeaderClass(day)" title="@day.ToString("dddd, dd MMMM yyyy")">
                            <span class="day-name">@day.ToString("ddd")</span>
                            <span class="day-date">@day.ToString("dd MMM")</span>
                            <span class="day-number">@day.ToString("dd")</span>
                        </div>
                    }
                </div>
                <div class="room-column-header summary-label">
                    <button type="button"
                            class="summary-toggle"
                            title="@L["Show availability by room type"]"
                            aria-expanded="@(showRoomTypeBreakdown ? "true" : "false")"
                            @onclick="() => showRoomTypeBreakdown = !showRoomTypeBreakdown">
                        <span class="summary-toggle-icon">@(showRoomTypeBreakdown ? "▾" : "▸")</span>
                        @L["Free / occupancy"]
                    </button>
                </div>
                <div class="timeline-header summary-row" style="@TimelineColumnsStyle">
                    @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                    {
                        var day = snapshot.StartDate.AddDays(dayOffset);
                        var summary = GetDaySummary(visibleRooms, day);
                        <div class="@GetSummaryCellClass(summary)"
                             title="@L["{0} free · {1} occupied · {2} out of order", summary.Free, summary.Occupied, summary.OutOfOrder]">
                            <span class="summary-free">@summary.Free</span>
                            <span class="summary-occupancy">@summary.OccupancyPercent%</span>
                        </div>
                    }
                </div>
                @if (showRoomTypeBreakdown)
                {
                    @foreach (var roomTypeGroup in visibleRooms.GroupBy(r => r.RoomType).OrderBy(g => g.Key))
                    {
                        var typeRooms = roomTypeGroup.ToList();
                        <div class="room-column-header summary-label summary-type-label" title="@roomTypeGroup.Key">
                            @roomTypeGroup.Key <span class="summary-type-count">(@typeRooms.Count)</span>
                        </div>
                        <div class="timeline-header summary-row summary-type-row" style="@TimelineColumnsStyle">
                            @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                            {
                                var day = snapshot.StartDate.AddDays(dayOffset);
                                var summary = GetDaySummary(typeRooms, day);
                                <div class="@GetSummaryCellClass(summary) @(summary.Free == 0 ? "summary-sold-out" : null)"
                                     title="@roomTypeGroup.Key: @L["{0} free · {1} occupied · {2} out of order", summary.Free, summary.Occupied, summary.OutOfOrder]">
                                    <span class="summary-free">@summary.Free</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @foreach (var group in GetRoomGroups(visibleRooms))
            {
                var collapsed = group.Key is not null && collapsedGroups.Contains(group.Key);
                @if (group.Key is not null)
                {
                    <div class="planner-group-row">
                        <div class="room-column-header group-header">
                            <button type="button"
                                    class="group-toggle"
                                    aria-expanded="@(collapsed ? "false" : "true")"
                                    @onclick="() => ToggleGroup(group.Key)">
                                <span class="summary-toggle-icon">@(collapsed ? "▸" : "▾")</span>
                                <span class="group-title">@group.Label</span>
                                <span class="summary-type-count">(@group.Rooms.Count)</span>
                            </button>
                        </div>
                        <div class="timeline-header summary-row group-summary-row" style="@TimelineColumnsStyle">
                            @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                            {
                                var day = snapshot.StartDate.AddDays(dayOffset);
                                var summary = GetDaySummary(group.Rooms, day);
                                <div class="summary-cell group-summary-cell @(summary.Free == 0 ? "summary-sold-out" : null)"
                                     title="@group.Label: @L["{0} free · {1} occupied · {2} out of order", summary.Free, summary.Occupied, summary.OutOfOrder]">
                                    <span class="summary-free">@summary.Free</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (collapsed)
                {
                    continue;
                }

                @foreach (var room in group.Rooms)
                {
                <div class="planner-room-row">
                    <div class="room-card"
                         title="@GetRoomCardTitle(room)"
                         @oncontextmenu="args => OpenRoomMenu(args, room)"
                         @oncontextmenu:preventDefault="true">
                        <button type="button"
                                class="hk-dot hk-button @GetHousekeepingClass(room.HousekeepingStatus)"
                                aria-label="@L["Housekeeping: {0}", GetHousekeepingLabel(room.HousekeepingStatus)]"
                                @onclick="args => OpenRoomMenu(args, room)"></button>
                        <span class="room-number">@room.RoomNumber</span>
                        <span class="room-type">@room.RoomType</span>
                        <span class="room-floor">@L["Floor {0}", room.Floor]</span>
                    </div>

                    <div class="timeline-row" data-room-id="@room.RoomId" style="@HalfDayColumnsStyle">
                        @for (var dayOffset = 0; dayOffset < snapshot.Days; dayOffset++)
                        {
                            var day = snapshot.StartDate.AddDays(dayOffset);
                            <div class="@GetDayCellClass(day)"
                                 data-room-id="@room.RoomId"
                                 data-day="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                 style="grid-column: @(dayOffset * 2 + 1) / span 2; grid-row: 1;"></div>
                        }

                        @foreach (var reservation in room.Reservations)
                        {
                            var placement = GetPlacement(reservation);
                            if (placement is null)
                            {
                                continue;
                            }

                            <button type="button"
                                    class="@GetReservationChipClass(reservation, placement.Value)"
                                    style="grid-column: @($"{placement.Value.StartColumn} / {placement.Value.EndColumn}"); grid-row: 1;"
                                    aria-label="@BuildReservationTitle(reservation)"
                                    data-reservation-id="@reservation.ReservationId"
                                    data-room-id="@room.RoomId"
                                    data-check-in="@reservation.CheckIn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                    data-check-out="@reservation.CheckOut.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                    data-locked="@(isExecutingAction ? "true" : "false")"
                                    data-card-guest="@reservation.GuestName"
                                    data-card-room="@($"{room.RoomNumber} · {room.RoomType}")"
                                    data-card-dates="@($"{reservation.CheckIn:ddd, dd MMM} – {reservation.CheckOut:ddd, dd MMM yyyy}")"
                                    data-card-nights="@(reservation.CheckOut.DayNumber - reservation.CheckIn.DayNumber)"
                                    data-card-occupancy="@reservation.Occupancy"
                                    data-card-status="@GetStatusLabel(reservation.Status)"
                                    data-card-status-class="@GetStatusClass(reservation.Status)"
                                    data-card-notes="@reservation.Notes"
                                    @onclick="() => StartEditReservationAsync(room.RoomId, reservation)"
                                    @oncontextmenu="args => OpenContextMenu(args, room, reservation)"
                                    @oncontextmenu:preventDefault="true">
                                <span class="reservation-resize-handle reservation-resize-handle-start"
                                      @onclick:stopPropagation="true">
                                </span>
                                <span class="reservation-guest">@reservation.GuestName</span>
                                <span class="reservation-dates">@reservation.CheckIn.ToString("dd MMM") - @reservation.CheckOut.ToString("dd MMM")</span>
                                <span class="reservation-resize-handle reservation-resize-handle-end"
                                      @onclick:stopPropagation="true">
                                </span>
                            </button>
                        }
                    </div>
                </div>
                }
            }
        </div>

        @if (roomMenu is not null)
        {
            <div class="context-menu-backdrop"
                 @onclick="CloseContextMenu"
                 @oncontextmenu="CloseContextMenu"
                 @oncontextmenu:preventDefault="true"></div>
            <div class="context-menu" role="menu" style="@($"left: {roomMenu.X.ToString(CultureInfo.InvariantCulture)}px; top: {roomMenu.Y.ToString(CultureInfo.InvariantCulture)}px;")">
                <div class="context-menu-title">
                    <span class="hk-dot @GetHousekeepingClass(roomMenu.Room.HousekeepingStatus)"></span>
                    <span>@L["Room {0}", roomMenu.Room.RoomNumber]</span>
                    <span class="context-menu-subtitle">@roomMenu.Room.RoomType · @L["Floor {0}", roomMenu.Room.Floor]</span>
                </div>
                <div class="context-menu-heading">@L["Housekeeping"]</div>
                @foreach (var housekeepingStatus in housekeepingStatuses)
                {
                    var isCurrent = roomMenu.Room.HousekeepingStatus == housekeepingStatus;
                    <button type="button" role="menuitemradio"
                            aria-checked="@(isCurrent ? "true" : "false")"
                            class="context-menu-item @(isCurrent ? "context-menu-current" : null)"
                            @onclick="() => SetHousekeepingStatusAsync(housekeepingStatus)">
                        <span class="hk-dot @GetHousekeepingClass(housekeepingStatus)"></span>
                        @GetHousekeepingLabel(housekeepingStatus)
                        @if (isCurrent)
                        {
                            <span class="context-menu-check">✓</span>
                        }
                    </button>
                }
                <div class="context-menu-separator"></div>
                <button type="button" role="menuitem" class="context-menu-item" @onclick="RoomMenuCreateReservation">+ @L["New reservation in this room"]</button>
                <button type="button" role="menuitem" class="context-menu-item" @onclick="RoomMenuEditRoom">✎ @L["Edit room..."]</button>
            </div>
        }

        @if (contextMenu is not null)
        {
            var menuReservation = contextMenu.Reservation;
            <div class="context-menu-backdrop"
                 @onclick="CloseContextMenu"
                 @oncontextmenu="CloseContextMenu"
                 @oncontextmenu:preventDefault="true"></div>
            <div class="context-menu" role="menu" style="@($"left: {contextMenu.X.ToString(CultureInfo.InvariantCulture)}px; top: {contextMenu.Y.ToString(CultureInfo.InvariantCulture)}px;")">
                <div class="context-menu-title">
                    <span class="legend-badge @GetStatusClass(menuReservation.Status)"></span>
                    <span>@menuReservation.GuestName</span>
                    <span class="context-menu-subtitle">@contextMenu.RoomLabel</span>
                </div>
                <button type="button" role="menuitem" class="context-menu-item" @onclick="() => ContextEditAsync(false)">✎ @L["Open reservation"]</button>
                <button type="button" role="menuitem" class="context-menu-item" @onclick="() => ContextEditAsync(true)">€ @L["Billing & invoice"]</button>
                <div class="context-menu-separator"></div>
                <button type="button" role="menuitem" class="context-menu-item"
                        disabled="@(menuReservation.Status != ReservationStatus.Confirmed)"
                        @onclick="ContextCheckInAsync">
                    ⇥ @L["Check in"]
                </button>
                <button type="button" role="menuitem" class="context-menu-item"
                        disabled="@(menuReservation.Status != ReservationStatus.CheckedIn)"
                        @onclick="ContextCheckOutAsync">
                    ⇤ @L["Check out"]
                </button>
                <div class="context-menu-separator"></div>
                <button type="button" role="menuitem" class="context-menu-item context-menu-danger"
                        disabled="@(menuReservation.Status is ReservationStatus.CheckedOut or ReservationStatus.Cancelled)"
                        @onclick="ContextCancelAsync">
                    ✕ @L["Cancel reservation"]
                </button>
            </div>
        }
    }

    @if (editor is not null && snapshot is not null)
    {
        <aside class="editor-drawer" role="dialog" aria-label="@(editor.ReservationId is null ? L["Create reservation"] : L["Edit reservation"])">
        <section class="reservation-editor">
            <div class="reservation-editor-header">
                <div>
                    <h2>@(editor.ReservationId is null ? L["Create reservation"] : L["Edit reservation"])</h2>
                    <div class="reservation-editor-subtitle">
                        @L["Room {0}", GetRoomLabel(editor.RoomId)] · @editor.CheckIn.ToString("ddd, dd MMM") – @editor.CheckOut.ToString("ddd, dd MMM yyyy")
                        @if (editor.CheckOut > editor.CheckIn)
                        {
                            var editorNights = editor.CheckOut.DayNumber - editor.CheckIn.DayNumber;
                            <span> · @(editorNights == 1 ? L["{0} night", editorNights] : L["{0} nights", editorNights])</span>
                        }
                    </div>
                </div>
                <button type="button"
                        class="btn-close editor-drawer-close"
                        aria-label="@L["Close"]"
                        title="@L["Close (Esc)"]"
                        @onclick="CloseEditor"
                        disabled="@isExecutingAction"></button>
            </div>

            <div class="reservation-editor-grid">
                <div>
                    <label class="form-label" for="editor-room">@L["Room"]</label>
                    <select id="editor-room" class="form-select" @bind="editor.RoomId" disabled="@isExecutingAction">
                        @foreach (var room in snapshot.Rooms)
                        {
                            <option value="@room.RoomId">@room.RoomNumber · @room.RoomType</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="editor-guest">@L["Guest / block name"]</label>
                    <input id="editor-guest" class="form-control" @bind="editor.GuestName" disabled="@isExecutingAction" />
                </div>
                <div>
                    <label class="form-label" for="editor-checkin">@L["Check-in"]</label>
                    <InputDate id="editor-checkin" class="form-control" @bind-Value="editor.CheckIn" disabled="@isExecutingAction" />
                </div>
                <div>
                    <label class="form-label" for="editor-checkout">@L["Check-out"]</label>
                    <InputDate id="editor-checkout" class="form-control" @bind-Value="editor.CheckOut" disabled="@isExecutingAction" />
                </div>
                <div>
                    <label class="form-label" for="editor-status">@L["Status"]</label>
                    <InputSelect id="editor-status" class="form-select" @bind-Value="editor.Status" disabled="@isExecutingAction">
                        <option value="@ReservationStatus.Confirmed">@GetStatusLabel(ReservationStatus.Confirmed)</option>
                        <option value="@ReservationStatus.Maintenance">@GetStatusLabel(ReservationStatus.Maintenance)</option>
                        <option value="@ReservationStatus.Blocked">@GetStatusLabel(ReservationStatus.Blocked)</option>
                        <option value="@ReservationStatus.CheckedIn">@GetStatusLabel(ReservationStatus.CheckedIn)</option>
                    </InputSelect>
                </div>
                <div>
                    <label class="form-label" for="editor-occupancy">
                        @L["Occupancy"]
                        @if (EditorMaxOccupancy is { } maxGuests)
                        {
                            <small class="text-muted">(@L["max. {0}", maxGuests])</small>
                        }
                    </label>
                    <InputNumber id="editor-occupancy" class="form-control" @bind-Value="editor.Occupancy" disabled="@isExecutingAction" />
                </div>
                <div class="editor-notes">
                    <label class="form-label" for="editor-notes">@L["Notes"]</label>
                    <textarea id="editor-notes" class="form-control" rows="2" @bind="editor.Notes" disabled="@isExecutingAction"></textarea>
                </div>
            </div>

            @if (editor.CheckOut <= editor.CheckIn)
            {
                <div class="editor-validation-error">@L["Check-out must be after check-in."]</div>
            }
            else if (editor.Occupancy <= 0)
            {
                <div class="editor-validation-error">@L["Occupancy must be greater than 0."]</div>
            }
            else if (EditorMaxOccupancy is { } limit && editor.Occupancy > limit)
            {
                <div class="editor-validation-error">@L["This room allows at most {0} guest(s).", limit]</div>
            }

            <section class="rate-quote-section">
                <div class="rate-quote-header">
                    <h3>@L["Rate quote"]</h3>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="RefreshRateQuoteAsync"
                            disabled="@(isExecutingAction || editor.CheckOut <= editor.CheckIn || editor.Occupancy <= 0)">
                        @L["Calculate stay price"]
                    </button>
                </div>

                @if (rateQuoteError is not null)
                {
                    <div class="alert alert-warning" role="alert">@rateQuoteError</div>
                }
                else if (rateQuote is not null)
                {
                    <div class="rate-quote-kpis">
                        <div>
                            <div class="rate-quote-value">@rateQuote.Nights</div>
                            <div class="rate-quote-label">@L["Nights"]</div>
                        </div>
                        <div>
                            <div class="rate-quote-value">@MoneyFormatter.Format(rateQuote.NetAmount)</div>
                            <div class="rate-quote-label">@L["Net total"]</div>
                        </div>
                        <div>
                            <div class="rate-quote-value">@MoneyFormatter.Format(rateQuote.VatAmount)</div>
                            <div class="rate-quote-label">@L["VAT total"]</div>
                        </div>
                        <div>
                            <div class="rate-quote-value">@MoneyFormatter.Format(rateQuote.GrossAmount)</div>
                            <div class="rate-quote-label">@L["Gross total"]</div>
                        </div>
                    </div>
                }
            </section>

            <div class="reservation-editor-actions">
                <button type="button"
                        class="btn btn-success"
                        @onclick="SaveReservationAsync"
                        disabled="@(isExecutingAction || editor.CheckOut <= editor.CheckIn || editor.Occupancy <= 0)">
                    @L["Save"]
                </button>

                @if (editor.ReservationId is not null)
                {
                    <button type="button"
                            class="btn btn-outline-success"
                            @onclick="CheckInReservationAsync"
                            disabled="@(isExecutingAction || editor.Status != ReservationStatus.Confirmed)">
                        @L["Check in"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-dark"
                            @onclick="CheckOutReservationAsync"
                            disabled="@(isExecutingAction || editor.Status != ReservationStatus.CheckedIn)">
                        @L["Check out"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            @onclick="CancelReservationAsync"
                            disabled="@(isExecutingAction || editor.Status is ReservationStatus.CheckedOut or ReservationStatus.Cancelled)">
                        @L["Cancel"]
                    </button>
                }
            </div>

            @if (editor.ReservationId is not null)
            {
                <section class="billing-section">
                    <h3>@L["Billing & Invoicing (AT / EU)"]</h3>

                    @if (billingError is not null)
                    {
                        <div class="alert alert-danger" role="alert">@billingError</div>
                    }
                    else if (billingMessage is not null)
                    {
                        <div class="alert alert-success" role="alert">@billingMessage</div>
                    }

                    @if (isLoadingBilling || billingSnapshot is null || billingReservationId != editor.ReservationId)
                    {
                        <p><em>@L["Loading billing data..."]</em></p>
