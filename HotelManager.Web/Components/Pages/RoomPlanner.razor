    private async Task ExecuteReservationActionAsync(
        Func<Task<RoomPlannerReservation>> action,
        string successMessage,
        bool closeEditor = true)
    {
        isExecutingAction = true;
        ClearOperationMessages();

        try
        {
            await action();
            operationMessage = successMessage;
            await ReloadAsync();
            if (closeEditor)
            {
                editor = null;
            }
        }
        catch (ReservationValidationException exception)
        {
            operationError = exception.Message;
        }
        catch (ReservationConflictException exception)
        {
            operationError = exception.Message;
        }
        catch (ReservationNotFoundException exception)
        {
            operationError = exception.Message;
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    private async Task LoadBillingAsync(Guid reservationId)
    {
        isLoadingBilling = true;
        billingError = null;
        billingMessage = null;

        try
        {
            billingSnapshot = await BillingService.GetFolioAsync(reservationId, CancellationToken.None);
            billingReservationId = reservationId;
            ResetBillingForms();
        }
        catch (BillingNotFoundException exception)
        {
            billingError = exception.Message;
            billingSnapshot = null;
        }
        catch (BillingValidationException exception)
        {
            billingError = exception.Message;
            billingSnapshot = null;
        }
        finally
        {
            isLoadingBilling = false;
        }
    }

    private async Task RefreshRateQuoteAsync()
    {
        if (editor is null)
        {
            return;
        }

        rateQuoteError = null;
        rateQuote = null;

        if (editor.CheckOut <= editor.CheckIn)
        {
            rateQuoteError = L["Check-out must be after check-in."];
            return;
        }

        if (editor.Occupancy <= 0)
        {
            rateQuoteError = L["Occupancy must be greater than 0."];
            return;
        }

        try
        {
            var quote = await RateAvailabilityService.QuoteAsync(
                new RoomRateQuoteRequest(editor.RoomId, editor.CheckIn, editor.CheckOut, editor.Occupancy),
                CancellationToken.None);

            if (!quote.IsQuoteable)
            {
                rateQuoteError = quote.Message ?? L["No room rate is configured for the requested stay."];
                return;
            }

            rateQuote = quote;
        }
        catch (ReservationValidationException exception)
        {
            rateQuoteError = exception.Message;
        }
        catch (ReservationConflictException exception)
        {
            rateQuoteError = exception.Message;
        }
    }

