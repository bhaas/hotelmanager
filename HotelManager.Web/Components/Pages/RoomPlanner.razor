    private async Task RefreshRateQuoteAsync()
    {
        if (editor is null)
        {
            return;
        }

        rateQuoteError = null;
        rateQuote = null;

        if (editor.CheckOut <= editor.CheckIn)
        {
            rateQuoteError = L["Check-out must be after check-in."];
            return;
        }

        if (editor.Occupancy <= 0)
        {
            rateQuoteError = L["Occupancy must be greater than 0."];
            return;
        }

        try
        {
            var quote = await RateAvailabilityService.QuoteAsync(
                new RoomRateQuoteRequest(editor.RoomId, editor.CheckIn, editor.CheckOut, editor.Occupancy),
                CancellationToken.None);

            if (!quote.IsQuoteable)
            {
                rateQuoteError = quote.Message ?? L["No room rate is configured for the requested stay."];
                return;
            }

            rateQuote = quote;
        }
        catch (ReservationValidationException exception)
        {
            rateQuoteError = exception.Message;
        }
        catch (ReservationConflictException exception)
        {
            rateQuoteError = exception.Message;
        }
    }

    private async Task AddFolioEntryAsync()
    {
        if (editor?.ReservationId is null)
        {
            return;
        }

        var request = new BillingAddFolioEntryRequest(
            billingEntry.Description,
            billingEntry.EntryType,
            billingEntry.Quantity,
            billingEntry.UnitNetAmount,
            billingEntry.VatRatePercent,
            billingEntry.ServiceDate,
