    private async Task DropReservationAsync(Guid roomId, DateOnly checkInDate)
    {
        if (dragReservation is null || isExecutingAction)
        {
            return;
        }

        var source = dragReservation;
        Guid newRoomId;
        DateOnly newCheckIn;
        DateOnly newCheckOut;
        string message;

        try
        {
            (newRoomId, newCheckIn, newCheckOut, message) = ResolveDropResult(source, roomId, checkInDate);

            if (newCheckOut <= newCheckIn)
            {
                operationError = L["Check-out must be after check-in."];
                return;
            }

            if (source.RoomId == newRoomId && source.CheckIn == newCheckIn && source.CheckOut == newCheckOut)
            {
                return;
            }

            isExecutingAction = true;
            ClearOperationMessages();

            var request = new RoomPlannerReservationUpsertRequest(
                newRoomId,
                source.GuestName,
                newCheckIn,
                newCheckOut,
                source.Occupancy,
                source.Status,
                source.Notes);

            await RoomPlannerCommandService.UpdateReservationAsync(source.ReservationId, request, CancellationToken.None);
            operationMessage = message;

            if (editor?.ReservationId == source.ReservationId)
            {
                editor.RoomId = newRoomId;
                editor.CheckIn = newCheckIn;
                editor.CheckOut = newCheckOut;
                rateQuote = null;
                rateQuoteError = null;
                await RefreshRateQuoteAsync();
            }

            await ReloadAsync();
        }
        catch (ReservationValidationException exception)
        {
            operationError = exception.Message;
        }
        catch (ReservationConflictException exception)
        {
            operationError = exception.Message;
        }
        catch (ReservationNotFoundException exception)
        {
            operationError = exception.Message;
        }
        finally
