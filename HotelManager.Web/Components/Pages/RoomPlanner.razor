    private string GetHousekeepingLabel(HousekeepingStatus status) => status switch
    {
        HousekeepingStatus.Dirty => L["Dirty"],
        HousekeepingStatus.Inspected => L["Inspected"],
        _ => L["Clean"]
    };

    private static string GetHousekeepingClass(HousekeepingStatus status) => status switch
    {
        HousekeepingStatus.Dirty => "hk-dirty",
        HousekeepingStatus.Inspected => "hk-inspected",
        _ => "hk-clean"
    };

    private IEnumerable<RoomGroup> GetRoomGroups(List<RoomPlannerRoom> rooms)
    {
        return groupBy switch
        {
            "floor" => rooms
                .GroupBy(room => room.Floor)
                .OrderBy(group => group.Key)
                .Select(group => new RoomGroup($"floor:{group.Key}", L["Floor {0}", group.Key], group.ToList())),
            "type" => rooms
                .GroupBy(room => room.RoomType, StringComparer.OrdinalIgnoreCase)
                .OrderBy(group => group.Key)
                .Select(group => new RoomGroup($"type:{group.Key}", group.Key, group.ToList())),
            _ => [new RoomGroup(null, string.Empty, rooms)]
        };
    }

    private void ToggleGroup(string key)
    {
        if (!collapsedGroups.Remove(key))
        {
            collapsedGroups.Add(key);
        }
    }

    private void DismissToast()
    {
        toastTimer?.Cancel();
        ClearOperationMessages();
    }

    private void ScheduleToastDismiss(int delayMilliseconds)
    {
        toastTimer?.Cancel();
        var timer = toastTimer = new CancellationTokenSource();
        var message = operationMessage;
        _ = DismissToastLaterAsync(message, delayMilliseconds, timer.Token);
    }

    private async Task DismissToastLaterAsync(string? message, int delayMilliseconds, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delayMilliseconds, cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (ReferenceEquals(operationMessage, message) && !isExecutingAction)
            {
                operationMessage = null;
                undoState = null;
                StateHasChanged();
            }
        });
    }

    private async Task UndoAsync()
    {
        if (undoState is null || isExecutingAction)
        {
            return;
        }

        var undo = undoState;
        await ExecuteReservationActionAsync(
            () => RoomPlannerCommandService.UpdateReservationAsync(undo.ReservationId, undo.Previous, CancellationToken.None),
            L["Change undone."],
            closeEditor: false);

        if (operationError is null && editor?.ReservationId == undo.ReservationId)
        {
            editor.RoomId = undo.Previous.RoomId;
            editor.CheckIn = undo.Previous.CheckIn;
            editor.CheckOut = undo.Previous.CheckOut;
            await RefreshRateQuoteAsync();
        }
    }

    private async Task ContextEditAsync(bool scrollToBilling)
    {
        if (contextMenu is null)
        {
            return;
        }

        var menu = contextMenu;
        contextMenu = null;
        await StartEditReservationAsync(menu.RoomId, menu.Reservation);
