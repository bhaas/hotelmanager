@page "/account/login"
@layout AccountLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IStringLocalizer<Login> L
@inject ILogger<Login> Logger

<PageTitle>@L["Sign in"] · HotelManager</PageTitle>

<section class="auth-card">
    <h1>@L["Sign in"]</h1>
    <p class="auth-subtitle">@L["Welcome back. Sign in to your hotel."]</p>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <EditForm Model="Input" method="post" OnSubmit="SignInAsync" FormName="login" class="auth-form">
        <label class="form-label" for="login-email">@L["Email"]</label>
        <InputText id="login-email" @bind-Value="Input.Email" type="email" class="form-control" autocomplete="username" autofocus required />

        <label class="form-label" for="login-password">@L["Password"]</label>
        <InputText id="login-password" @bind-Value="Input.Password" type="password" class="form-control" autocomplete="current-password" required />

        <label class="form-check">
            <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" />
            <span class="form-check-label">@L["Keep me signed in"]</span>
        </label>

        <button type="submit" class="btn btn-primary w-100">@L["Sign in"]</button>
    </EditForm>
</section>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new LoginInput();

    private async Task SignInAsync()
    {
        if (string.IsNullOrWhiteSpace(Input.Email) || string.IsNullOrEmpty(Input.Password))
        {
            errorMessage = L["Enter your email address and password."];
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(Input.Email.Trim(), Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Logger.LogInformation("User {Email} signed in.", Input.Email.Trim());
            Navigation.NavigateTo(GetSafeReturnUrl(), forceLoad: true);
            return;
        }

        var noHotelAccess = false;
        if (result.IsNotAllowed)
        {
            // Only reveal the reason when the password is correct.
            var user = await SignInManager.UserManager.FindByEmailAsync(Input.Email.Trim());
            noHotelAccess = user is not null && await SignInManager.UserManager.CheckPasswordAsync(user, Input.Password);
        }

        errorMessage = result.IsLockedOut
            ? L["This account is locked. Try again later or contact your administrator."]
            : noHotelAccess
                ? L["Your account has no access to an active hotel. Contact your administrator."]
                : L["Invalid email address or password."];
    }

    private string GetSafeReturnUrl()
    {
        var url = ReturnUrl;
        return !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") &&
               !url.StartsWith("/account/", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";
    }

    private sealed class LoginInput
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
