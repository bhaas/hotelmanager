@inject IStringLocalizer<NavMenu> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HotelManager</a>
    </div>
</div>

<input type="checkbox" title="@L["Navigation menu"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @L["Home"]
            </NavLink>
        </div>

        <AuthorizeView Policy="@HotelPolicies.FrontOffice">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="room-planner">
                    <span class="bi bi-calendar-week-nav-menu" aria-hidden="true"></span> @L["Room Planner"]
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@HotelPolicies.ManageProperty">
            <div class="nav-section px-3">@L["Settings"]</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings/rates">
                    <span class="bi bi-tags-nav-menu" aria-hidden="true"></span> @L["Rates & availability"]
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings/rooms">
                    <span class="bi bi-door-nav-menu" aria-hidden="true"></span> @L["Rooms & categories"]
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@HotelPolicies.ManageUsers">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings/users">
                    <span class="bi bi-people-nav-menu" aria-hidden="true"></span> @L["Users & roles"]
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings/hotel">
                    <span class="bi bi-building-nav-menu" aria-hidden="true"></span> @L["Hotel profile"]
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@HotelPolicies.ManagePlatform">
            <div class="nav-section px-3">@L["Platform"]</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="platform/hotels">
                    <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> @L["All hotels"]
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>
